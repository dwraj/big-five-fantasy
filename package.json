{
  "name": "big-five-fantasy",
  "version": "1.0.0",
  "description": "Fantasy football platform for European top 5 leagues",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "setup:db": "node server/scripts/setupDb.js",
    "sync:players": "node server/scripts/syncPlayers.js",
    "sync:fixtures": "node server/scripts/syncFixtures.js",
    "sync:live": "node server/scripts/syncLiveScores.js",
    "git:add": "git add .",
    "git:commit": "git commit -m",
    "git:push": "git push origin main"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "@supabase/supabase-js": "^2.38.4",
    "axios": "^1.6.2",
    "node-cron": "^3.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}
